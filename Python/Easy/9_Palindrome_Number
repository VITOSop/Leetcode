# 1
class Solution:
    def isPalindrome(self, x: int) -> bool:
        s=str(x)
        return s[:]==s[::-1]

# 2
class Solution:
    def isPalindrome(self, x: int) -> bool:
        s=str(x).lower()
        start = 0
        end = len(s)-1

        while start<end:
            if s[start]!=s[end]:
                return False

            start+=1
            end-=1
        
        return True
